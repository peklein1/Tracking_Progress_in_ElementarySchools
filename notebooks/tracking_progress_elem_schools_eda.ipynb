   "source": [
    "query5 = \"\"\"\n",
    "WITH summary AS (\n",
    "    SELECT\n",
    "        at_risk_behavior_flag,\n",
    "        COUNT(*) AS event_count,\n",
    "        AVG(scale_score) AS avg_value\n",
    "    FROM Diagnostic_Results\n",
    "    GROUP BY at_risk_behavior_flag\n",
    ")\n",
    "SELECT *\n",
    "FROM summary\n",
    "ORDER BY avg_value DESC;\n",
    "\"\"\"\n",
    "result5 = pd.read_sql_query(query5, conn)\n",
    "result5"
   ]
  },
