   "source": [
    "## Build SQL Relational Tables"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 87,
   "id": "f2e4a964",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import sqlite3\n",
    "\n",
    "# -----------------------------\n",
    "# 1. Load your actual files\n",
    "# -----------------------------\n",
    "df_school_improve = pd.read_csv(\"../data/cleaned/KYRC25_ACCT_School_Improvement_Cleaned.csv\")\n",
    "df_diag = pd.read_csv(\"../data/cleaned/Simulated_Diagnostic-Results_With-Behavior_Cleaned.csv\")\n",
    "\n",
    "# -----------------------------\n",
    "# 2. Clean column names (optional but recommended)\n",
    "# -----------------------------\n",
    "df_school_improve.columns = df_school_improve.columns.str.replace(\" \", \"_\")\n",
    "df_diag.columns = df_diag.columns.str.replace(\" \", \"_\")\n",
    "\n",
    "# -----------------------------\n",
    "# 3. Connect to SQLite\n",
    "# -----------------------------\n",
    "conn = sqlite3.connect(\"../database_name.db\")\n",
    "\n",
    "# -----------------------------\n",
    "# 4. Select REAL columns\n",
    "# -----------------------------\n",
    "# School Improvement columns (verified from your file)\n",
    "df_school_improve = df_school_improve[\n",
    "    [\n",
    "        \"school_year\",\n",
    "        \"county_number\",\n",
    "        \"county_name\",\n",
    "        \"district_number\",\n",
    "        \"district_name\",\n",
    "        \"school_number\",\n",
    "        \"school_name\",\n",
    "        \"school_code\",\n",
    "        \"state_school_id\",\n",
    "        \"nces_id\",\n",
    "        \"co_op\",\n",
    "        \"co_op_code\",\n",
    "        \"school_type\",\n",
    "        \"federal_classification\",\n",
    "        \"level\",\n",
    "        \"title_1\",\n",
    "        \"number_of_years_identified\",\n",
    "        \"reason_for_federal_classification\",\n",
    "    ]\n",
    "    ]\n",
    "\n",
    "# Diagnostic Results columns (verified from your file)\n",
    "df_diag = df_diag[\n",
    "    [\n",
    "        \"student\",\n",
    "        \"overall_placement_scale_score\",\n",
    "        \"scale_score\",\n",
    "        \"no_number_and_operations\",\n",
    "        \"alg_algebra_and_algebraic_thinking\",\n",
    "        \"ms_measurement_and_data\",\n",
    "        \"geo_geometry\",\n",
    "        \"typical_growth\",\n",
    "        \"stretch_growth\",\n",
    "        \"diagnostic_date\",\n",
    "        \"attendance_rate\",\n",
    "        \"tardies_ytd\",\n",
    "        \"behavior_incidents_ytd\",\n",
    "        \"positive_behavior_points\",\n",
    "        \"engagement_rating_1_5\",\n",
    "        \"at_risk_behavior_flag\",\n",
    "    ]\n",
    "]\n",
    "\n",
    "# -----------------------------\n",
    "# 5. Write to SQLite tables\n",
    "# -----------------------------\n",
    "df_school_improve.to_sql(\"School_Improvement\", conn, index=False, if_exists=\"replace\")\n",
    "df_diag.to_sql(\"Diagnostic_Results\", conn, index=False, if_exists=\"replace\")\n",
    "\n",
    "# -----------------------------\n",
    "# 6. Commit & close\n",
    "# -----------------------------\n",
    "conn.commit()\n",
    "conn.close()\n",
    "\n"
   ]
  },
