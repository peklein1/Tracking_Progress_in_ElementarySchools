    "query3 = \"\"\"\n",
    "SELECT\n",
    "    school_type,\n",
    "    COUNT(*) AS event_count,\n",
    "    AVG(number_of_years_identified) AS avg_value\n",
    "FROM School_Improvement\n",
    "GROUP BY school_type\n",
    "ORDER BY event_count DESC;\n",
    "\"\"\"\n",
    "result3 = pd.read_sql_query(query3, conn)\n",
    "result3"
