   "source": [
    "# Write a function that calculates percentages of missing values\n",
    "def calculate_missing_values(df):\n",
    "    \"\"\"\n",
    "    Calculate the number and percentage of missing values for each column in a dataframe.\n",
    "    \"\"\"\n",
    "    \n",
    "    missing_count = df.isna().sum()\n",
    "    missing_percent = (missing_count / len(df)) * 100\n",
    "    \n",
    "    missing_summary = pd.DataFrame({\n",
    "        \"missing_count\": missing_count,\n",
    "        \"missing_percent\": missing_percent\n",
    "    })\n",
    "    \n",
    "    return missing_summary.sort_values(\n",
    "        \"missing_percent\",\n",
    "        ascending=False\n",
    "    )\n",
    "\n",
    "missing_summary = calculate_missing_values(df)\n",
    "\n",
    "missing_summary"
   ]
  },
