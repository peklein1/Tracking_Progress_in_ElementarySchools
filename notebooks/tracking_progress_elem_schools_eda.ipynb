   "source": [
    "query8 = \"\"\"\n",
    "SELECT\n",
    "    a.school_name,\n",
    "    a.school_type,\n",
    "    b.federal_classification,\n",
    "    b.number_of_years_identified\n",
    "FROM School_Improvement AS a\n",
    "JOIN School_Improvement AS b\n",
    "    ON a.school_number = b.school_number\n",
    "LIMIT 100;\n",
    "\"\"\"\n",
    "result8 = pd.read_sql_query(query8, conn)\n",
    "result8"
   ]
